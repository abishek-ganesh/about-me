# Client-Side Analytics Configuration
# These values are used by the React app for browser-based tracking
# They are NOT needed for MCP-based analytics reporting

# Google Analytics 4 Measurement ID (for client-side tracking)
REACT_APP_GA4_MEASUREMENT_ID=G-R42V1KNSVD

# Microsoft Clarity Project ID (for client-side tracking)
REACT_APP_CLARITY_PROJECT_ID=spov57zm48

# Note: Analytics reporting via MCP uses different configuration:
# - GA4: Property ID 499560505 (used directly in analytics-mcp)
# - Clarity: API token in ~/.config/claude-code/mcp_servers.json