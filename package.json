{
  "name": "personal-site",
  "version": "3.0.1",
  "homepage": "https://abishekganesh.com",
  "license": "MIT",
  "engines": {
    "node": ">=14.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abishek-ganesh/about-me.git"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--openssl-legacy-provider' react-app-rewired build && react-snap",
    "build:no-snap": "NODE_OPTIONS='--openssl-legacy-provider' react-app-rewired build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "serve -s build",
    "dev": "NODE_OPTIONS='--openssl-legacy-provider' react-app-rewired start",
    "lint": "eslint src",
    "test": "react-app-rewired test",
    "analyze": "NODE_OPTIONS='--openssl-legacy-provider' source-map-explorer 'build/static/js/*.js'",
    "build:analyze": "npm run build:no-snap && npm run analyze",
    "generate:webp": "node scripts/generate-webp.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.34",
    "@fortawesome/free-brands-svg-icons": "^5.15.2",
    "@fortawesome/free-regular-svg-icons": "^5.15.2",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "0.1.14",
    "dayjs": "^1.10.4",
    "prop-types": "^15.7.2",
    "raw.macro": "^0.4.2",
    "react": "^17.0.1",
    "react-burger-menu": "^3.0.3",
    "react-dom": "^17.0.1",
    "react-ga": "^3.3.0",
    "react-helmet-async": "^1.0.7",
    "react-markdown": "^5.0.3",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^3.0.1",
    "react-snap": "^1.13.1",
    "rimraf": "^3.0.2",
    "sass": "^1.69.5"
  },
  "devDependencies": {
    "@testing-library/react": "^11.2.3",
    "critters-webpack-plugin": "^3.0.2",
    "customize-cra": "^1.0.0",
    "gh-pages": "^6.3.0",
    "gulp-sass": "^5.1.0",
    "react-app-rewired": "^2.2.1",
    "serve": "^14.2.4",
    "sharp": "^0.34.3",
    "source-map-explorer": "^2.5.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "reactSnap": {
    "include": [
      "/",
      "/about",
      "/resume",
      "/projects",
      "/voiceover",
      "/stats",
      "/contact"
    ],
    "inlineCss": true,
    "headless": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "source": "build",
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "fixWebpackChunksIssue": false,
    "puppeteerExecutablePath": false
  }
}
