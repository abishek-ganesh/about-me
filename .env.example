# Analytics Configuration
# Copy this file to .env and fill in your actual values

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Get this from: https://analytics.google.com/ > Admin > Data Streams > Your Web Stream
REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID
# Get this from: https://clarity.microsoft.com/ > Settings > Project ID
REACT_APP_CLARITY_PROJECT_ID=your_clarity_id_here

# Legacy Google Analytics (if you still want to keep it)
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X